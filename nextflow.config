// Singularity container cache. Change this as appropriate

profiles {
        singularity {
                singularity.enabled = true
                singularity.cacheDir = "./singularity"
                singularity.runOptions ="--no-home"
                singularity.autoMounts = true
                //singularity.autoMounts = false
                //runOptions = "-B \"$launchDir\" $mounts.datadir $mounts.outdir"
        }

        apptainer {
                apptainer.enabled = true
                apptainer.cacheDir = "./singularity"
                apptainer.runOptions ="--no-home"
                apptainer.enabled = true
                apptainer.autoMounts = true
        }

        slurm {
                process {
                        executor = 'slurm'
                        withLabel: cpu {
                                clusterOptions = "--partition=YOUR_PARTITION --account='${params.slurm_account}'"
                        }
                }
        }
}

// ensure that no user libraries get mounted into the container
process.containerOptions = "--no-home"

env {
    PYTHONNOUSERSITE = 1
}

// Default parameters. Commandline parameters will take priority over these
params {
        slurm_account = ''
	outdir = './results'
	data_dir = "${projectDir}/databases"
	threads = 4
	skip_nanocomp = false
	nanocomp_threads = 4
	skip_assembly = false
	flye_threads = 4
	flye_args = "--asm-coverage 100"
	genome_size = "2.3M"
	skip_polishing= false
	medaka_threads = 12
	//ensure the correct nedaka model is indicated below and matches the guppy/dorado basecalling model
	medaka_model = "r1041_e82_400bps_sup_v5.0.0"
	skip_quast= false
	quast_threads = 2
	skip_checkm = false
	skip_download_checkm_db = true
	checkm_db = "${projectDir}/databases/checkm_data_2015_01_16"
	skip_sylph = false
	skip_download_sylph_db = true
	sylph_threads = 6
	sylph_db_gtdb_file = 'http://faust.compbio.cs.cmu.edu/sylph-stuff/gtdb-r226-c200-dbv1.syldb'
	sylph_db_fungal_file = 'http://faust.compbio.cs.cmu.edu/sylph-stuff/fungi-refseq-2024-07-25-c200-v0.3.syldb'
	sylph_tax_gtdb_metadata = 'https://zenodo.org/records/15314244/files/gtdb_r226_metadata.tsv.gz'
        sylph_tax_fungal_metadata = 'https://zenodo.org/records/14320496/files/fungi_refseq_2024-07-25_metadata.tsv.gz'
	sylph_db = "${projectDir}/databases/sylph/*.syldb"
	sylph_metadata = "${projectDir}/databases/sylph/*.tsv.gz"
	skip_kaptive3 = false
	kaptive_db_9lps = "${projectDir}/databases/kaptive3_LPS_db_v1/9lps.gbk"
	minimap_threads = 6
	// Define the LPS reference data. Should contain:
	//   - reference_LPS.txt
	//   - LPS_subtype_database_v2.txt
	//   - phenotype_lookup.tsv
	//   - petG_X73_NZ_CM001580.fasta
	//   - all FASTA/GB files defined in reference_LPS.txt
	//   - .fai files for each FASTA
	reference_LPS_directory = "${projectDir}/databases/LPS"
	skip_clair3 = false
	clair3_model = "${projectDir}/databases/clair3_models/r1041_e82_400bps_sup_v500"
	clair3_threads = 4
	clair3_args = "--haploid_sensitive"
	skip_snpeff = false
	skip_mlst = false
	mlst_scheme = "pmultocida_2"
	skip_petg = false
	petg_threads = 2
	petg_min_length = 1570
	petg_min_identity = 95
	skip_bakta = false
	bakta_threads = 8
	skip_download_bakta_db = true	
	bakta_db = "${projectDir}/databases/bakta/db"
	bakta_args = "--proteins ${projectDir}/databases/LPS/L3_NC002663_LPS.gb"
	skip_amrfinder = false
	skip_download_amrfinder_db = true
	amrfinder_db = "${projectDir}/databases/amrfinderplus/2025-03-25.1"
	amrfinder_args = ""
}

// Process settings
process {
        time = '6h'
        withName: 'sylph|sylph_tax' {
        	time = '2h'
        }
        withName: 'minimap|flye|medaka|checkm' {
                time = '12h'
        }
        withName: 'download_bakta_db' {
        	time = '24h'
        }
        withLabel: high_memory {
                        memory = '150GB'
                        time = '8h'
                }
        withLabel: very_high_memory {
                        memory = 300.GB
                }
}

mounts {
        outdir = "-B \"`[[ \"${params.outdir}\" =~ ^/ ]] && echo ${params.outdir} || echo ${PWD}/${params.outdir}`\""
        data_dir = "-B \"`[[ \"${params.data_dir}\" =~ ^/ ]] && echo ${params.data_dir} || echo ${PWD}/${params.data_dir}`\""
}

// Not generally user-modifiable !!!
process {
	withName: checkm { container = 'docker://quay.io/staphb/checkm:1.2.2' }
	withName: sylph { container = 'docker://quay.io/biocontainers/sylph:0.8.1--ha6fb395_0' } 
	withName: 'sylph_tax' { container = 'docker://quay.io/biocontainers/sylph-tax:1.3.0--pyhdfd78af_0' } 
	withName: 'sylph_tax_download_metadata' { container = 'docker://quay.io/biocontainers/sylph-tax:1.3.0--pyhdfd78af_0' } 
	//withName: kaptive { container = 'docker://quay.io/biocontainers/kaptive:2.0.6--hdfd78af_0' }
	withName: kaptive3 { container = 'docker://quay.io/biocontainers/kaptive:3.0.0b6--pyhdfd78af_0' }
	withName: minimap { container = 'docker://quay.io/schandry_containers/minimap2-samtools:latest' }
	withName: flye { container = 'docker://quay.io/biocontainers/flye:2.9.5--py39h475c85d_2' }
	withName: medaka { container = 'docker://quay.io/biocontainers/medaka:2.0.1--py39hf77f13f_0' }
	withName: clair3 { container = 'docker://quay.io/biocontainers/clair3:1.2.0--py310h779eee5_0' }
	//withName: snpeff { container = 'docker://quay.io/biocontainers/snpeff:4.3--2' }
	//withName: snpsift { container = 'docker://quay.io/biocontainers/snpsift:4.3--py35_2' }
        withName: snpeff { container = 'docker://quay.io/biocontainers/snpeff:5.3.0a--hdfd78af_0' }
        withName: snpsift { container = 'docker://quay.io/biocontainers/snpsift:5.3.0a--hdfd78af_0' }
	withName: quast { container = 'docker://quay.io/biocontainers/quast:5.2.0--py39pl5321h4e691d4_3' } 
	withName: nanocomp { container = 'docker://quay.io/biocontainers/nanocomp:1.24.2--pyhdfd78af_0' }
	withName: mlst { container = 'docker://quay.io/biocontainers/mlst:2.33.1--hdfd78af_0' }
	withName: petg_blast { container = 'docker://quay.io/biocontainers/blast:2.17.0--h66d330f_0' }
	withName: 'bakta' { container = 'docker://quay.io/biocontainers/bakta:1.12.0--pyhdfd78af_0' }
        withName: 'download_bakta_db' { container = 'docker://quay.io/biocontainers/bakta:1.12.0--pyhdfd78af_0' }
	withName: 'amrfinder|download_amrfinder_db' { container = 'docker://quay.io/biocontainers/ncbi-amrfinderplus:4.0.23--hf69ffd2_0' }
}

// Debug and report options
trace {
  enabled = true
  file = "${params.outdir}/trace.txt"
  overwrite = true
}
timeline {
  enabled = true
  file = "${params.outdir}/timeline.html"
  overwrite = true
}
report {
  enabled = true
  file = "${params.outdir}/report.html"
  overwrite = true
}
dag {
  enabled = true
  file = "${params.outdir}/flowchart_dag.svg"
  overwrite = true
}

manifest {
  name = ''
  author = 'Valentine Murigneux, Julian Zaugg'
  description = 'Pasteurella multocida LPS typing pipeline for Nanopore data'
  mainScript = 'main.nf'
  version = '0.1'
}
